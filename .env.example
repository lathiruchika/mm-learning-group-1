# ── API mode ───────────────────────────────────────────────────────────────
# 'dummy' (default) → localStorage-backed dummy API
# 'real'            → real HTTP backend (set VITE_API_BASE_URL below)
VITE_API_MODE=dummy

# ── Real backend URL (only used when VITE_API_MODE=real) ───────────────────
VITE_API_BASE_URL=http://localhost:8080

# ── Dummy API simulation toggles (EPMCDMETST-70448) ───────────────────────
# Add artificial latency in ms (0 = off). Use to test loading spinners.
VITE_DUMMY_API_LATENCY_MS=0

# Probabilistic failure rate: 0 = never fail, 1 = always fail, 0.3 = 30% chance.
# Use to test error banners and retry flows. Default: 0 (safe for demo).
VITE_DUMMY_FAIL_RATE=0

# ── App user (no auth in this version) ────────────────────────────────────
VITE_APP_USERNAME=demo-user
