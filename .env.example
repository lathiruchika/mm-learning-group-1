# Copy to .env.local (or .env) to override defaults. All values are optional.

# dummy   = localStorage-backed dummy API, no backend needed (default)
# backend = call a real REST backend through axios
VITE_TODO_API_MODE=dummy

# Artificial latency of each dummy API call in milliseconds (default 500; use 0 in tests)
VITE_DUMMY_API_DELAY_MS=500

# Optional: probability 0..1 that a dummy API call fails with SIMULATED_ERROR (default 0)
VITE_DUMMY_API_ERROR_RATE=0

# Only used when VITE_TODO_API_MODE=backend
# VITE_BACKEND_BASE_URL=http://localhost:8080
