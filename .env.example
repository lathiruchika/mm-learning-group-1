# API mode selects which Todo provider the app uses.
#   dummy -> in-browser localStorage provider; no backend/network required.
#   real  -> axios-backed provider that talks to the Spring Boot backend.
# Defaults to "real" when unset (see src/api/apiAdapter.js).
VITE_API_MODE=dummy

# Base URL for the backend. Used ONLY in real mode; ignored in dummy mode.
VITE_API_BASE_URL=http://localhost:8080
